{
  "name": "dead-drop",
  "private": true,
  "type": "module",
  "description": "Dead Drop \u2014 async 1v1 hidden-movement duel. Engine workspace (M2) + web client (M3).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "typecheck": "npm run -s build && tsc --noEmit -p packages/engine && tsc --noEmit -p packages/sim",
    "build": "tsc -p packages/engine/tsconfig.build.json && tsc -p packages/sim/tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "npm run build && node packages/sim/dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
